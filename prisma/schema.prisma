generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)
  password   String
  name       String
}
